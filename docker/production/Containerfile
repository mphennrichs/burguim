# syntax=docker/dockerfile:1.7

# Build the Burguim production image: Frappe/ERPNext/HRMS + the custom `ury`
# app (this repo), with its 4 Vite frontends (self-order, pos, frontend,
# mosaic) baked in.
#
# Stage 2 mirrors frappe_docker's official `images/layered/Containerfile`
# almost verbatim (same base images, same `bench init` invocation, same
# entrypoint/start scripts pulled unmodified from a pinned frappe_docker
# checkout via the `frappe_docker` build context). Two deliberate
# deviations:
#
# 1. `bench init --skip-assets`, deferring `bench build` to its own step.
# 2. Our pre-built frontend dist is copied in AFTER `bench build`, not
#    before. `bench build` auto-detects `ury`'s root package.json "build"
#    script and reruns `yarn build` itself, from its OWN separate
#    `bench get-app` clone of the `ury` repo. Copying our verified
#    frontend-builder output in last means it always wins, regardless of
#    what bench build did or didn't rebuild.
#
# Both of those `bench get-app` clones (this one and the `bench init` one
# right below) happen INSIDE a RUN command's shell, invisible to BuildKit's
# cache key - so on its own, a plain RUN can silently reuse a stale cached
# clone from a build made before the current commit existed. The frontend
# case above is covered by (2)'s "always overwrite" trick, but that does
# nothing for the rest of `ury` (doctypes, api/*.py, hooks.py, ...), which
# only ever comes from that one clone with no second chance to overwrite it.
# Confirmed live: a build that published and looked entirely successful was
# silently missing a same-day new doctype and API module. The actual fix for
# that is CACHE_BUST below, which CI sets to the current commit sha on every
# build (see docker-publish.yml) - the `: "${CACHE_BUST}"` no-op forces the
# `bench init` RUN's cache key to change whenever it does, so the whole step
# (and everything `bench get-app` clones inside it) reruns from scratch on
# every commit. (2) stays anyway as a second, independent guarantee for the
# frontend specifically, in case CACHE_BUST is ever removed or misconfigured.

ARG FRAPPE_BRANCH=version-15
ARG FRAPPE_IMAGE_PREFIX=frappe
ARG FRAPPE_PATH=https://github.com/frappe/frappe

# ---------------------------------------------------------------------------
# Stage 1: build the 4 Vite frontends from this repo.
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS frontend-builder
WORKDIR /app

COPY package.json ./
COPY packages ./packages
COPY self-order ./self-order
COPY pos ./pos
COPY frontend ./frontend
COPY mosaic ./mosaic

# Each app's `vite build` writes straight into ../ury/public/<app> and
# ../ury/www/<app>.html (see each app's vite.config.ts / copy-html-entry
# script) - same layout `bench get-app` produces for the `ury` app, so these
# directories only need to exist, not be pre-populated.
#
# --ignore-scripts: root's postinstall hook also installs `urypos` (legacy,
# untouched, not one of the 4 apps this image ships) - it isn't in this build
# context, so the hook would fail with "can't cd to urypos". mosaic's own
# install is run explicitly below instead.
#
# mosaic/proxyOptions.js (dev-server-only Vite proxy config, statically
# imported by vite.config.js) does `require('../../../sites/common_site_config.json')`
# - a path that only resolves inside a real frappe-bench checkout
# (apps/ury/mosaic/../../../sites/...). It's never read at runtime during
# `vite build`, but esbuild still has to resolve the import to load the
# config, so a stub at the same relative location (/sites, three levels
# above /app/mosaic) is enough.
RUN mkdir -p ury/public ury/www /sites && \
    echo '{}' > /sites/common_site_config.json && \
    yarn install --check-files --ignore-scripts && \
    yarn ury-mosaic-install && \
    yarn ury-mosaic-build && \
    yarn ury-posv2-build && \
    yarn ury-frontend-build && \
    yarn ury-self-order-build

# ---------------------------------------------------------------------------
# Stage 2: bench init (frappe/erpnext/hrms/ury), then bench build with our
# frontends already in place.
# ---------------------------------------------------------------------------
FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder
ARG FRAPPE_BRANCH
ARG FRAPPE_PATH
ARG CACHE_BUST=""

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  bench init --apps_path=/opt/frappe/apps.json \
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --skip-assets \
    --verbose \
    /home/frappe/frappe-bench && \
  echo "{}" > /home/frappe/frappe-bench/sites/common_site_config.json

WORKDIR /home/frappe/frappe-bench
RUN bench build && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

# Overwrite with our own verified build - see the note above on why this
# has to come after `bench build`, not before.
COPY --from=frontend-builder --chown=frappe:frappe /app/ury/public /home/frappe/frappe-bench/apps/ury/ury/public
COPY --from=frontend-builder --chown=frappe:frappe /app/ury/www /home/frappe/frappe-bench/apps/ury/ury/www

# ---------------------------------------------------------------------------
# Stage 3: production image - identical to frappe_docker's official `backend`
# stage, entrypoint/start scripts copied unmodified from the pinned
# frappe_docker checkout (see the `frappe_docker` build context in CI).
# ---------------------------------------------------------------------------
FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root

COPY --from=frappe_docker resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY --from=frappe_docker resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
